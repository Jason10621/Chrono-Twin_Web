# Chrono-AI 코치용 Gemini API 키. 비워두면 Chrono-AI는 "아직 키가 없다"는 안내만
# 보여주고 나머지 사이트는 정상 동작합니다.
# 로컬 개발: 이 파일을 .env.local 로 복사하고 값을 채우세요.
# 배포(Vercel): 프로젝트 Settings > Environment Variables 에도 동일하게 등록해야 합니다.

GEMINI_API_KEY=

# 1차로 시도하는 모델(품질 우선, 짧은 타임아웃 내 무응답이면 즉시 포기하고 아래로 폴백).
GEMINI_MODEL=gemini-3.6-flash

# 2차 폴백 모델. 2026-09-19 실측 기준 gemini-3.5-flash-lite가 가장 빠르고 안정적으로 응답함.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
