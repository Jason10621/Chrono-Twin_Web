# Chrono-AI 코치용 — 아래 중 하나 이상 설정하면 자동으로 연결됩니다.
# 둘 다 비워두면 Chrono-AI는 "아직 키가 없다"는 안내만 보여주고 나머지 사이트는 정상 동작합니다.
# 로컬 개발: 이 파일을 .env.local 로 복사하고 값을 채우세요.
# 배포(Vercel): 프로젝트 Settings > Environment Variables 에도 동일하게 등록해야 합니다.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# gemini | claude 중 우선순위를 강제하고 싶을 때만 설정 (비워두면 있는 키를 자동 감지, claude 우선)
AI_PROVIDER=
